(function($){'use strict';$.fn.initOwMod41=function(){return this.each(function(){if($(this).data('init-41')){return;}
$(this).data('init-41',1);let element=$(this),elementAnim=element.find('.ow-mod__wrapper'),pager=element.find('.ow-pager'),slickSlider=element.find('.ow-slider'),prevArrow=element.find('.action--arrow-prev'),nextArrow=element.find('.action--arrow-next'),video=element.find('.ow-mod__vid-wrapper'),pagerFrom,nbSlides=0;element.find("img[aria-hidden=true]").removeAttr("aria-hidden");element.find('.ow-slide').each(function(){if($(this).children().length){nbSlides++;}else{$(this).remove();}});if(pager.length){pagerFrom=element.find('.ow-pager__num-from');element.find('.ow-pager__num-to').html(nbSlides)}
if(!elementAnim.hasClass('pm-anim-not-seen')&&video.length){video.attr('data-mage-init','{"owMod41Video": {}}').trigger('contentUpdated');}
elementAnim.on("animSeen",function(){if(video.length){video.attr('data-mage-init','{"owMod41Video": {}}').trigger('contentUpdated');}});if(nbSlides<=1){prevArrow.remove();nextArrow.remove();pager.remove();return;}
slickSlider.on('init',function(){slickSlider.addClass('slick-visible');});slickSlider.on('beforeChange',function(event,slick,currentSlide,nextSlide){pagerFrom.html(nextSlide+1);});slickSlider.slick({horizontal:1,accessibility:true,focusOnChange:false,infinite:false,lazyLoad:'ondemand',slidesToShow:1,slidesToScroll:1,dots:false,fade:true,autoplay:false,speed:300,arrows:true,rows:0,prevArrow:prevArrow,nextArrow:nextArrow});});};})(jQuery);