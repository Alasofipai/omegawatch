tem.url)}\">${renderImage(item, hiddenText, settings)}</a>`+`</div>`+`<div class=\"ow-prod__desc\"><div class=\"ow-prod__desc-link followlink\">`+(settings.greyBg?'':tagsHtml)\n+`<div class=\"ow-prod__desc-top\">`+(item.collection?`<p class=\"collection ow-font-bold ow-font-upper\">${item.collection}</p>`:'')\n+(item.name?`<p class=\"name\">${item.name}</p>`:'')\n+`</div>`+renderPrice(item.price)\n+renderActions(item,sku,hiddenText)\n+`</div></div>`+`</div>`+renderTracking(item,sku,fullName,settings)\n+`</div>`;},renderSlide:function(item,options={}){return`<li class=\"ow-slider__item swiper-slide\" data-product-sku=\"${rawSku(item.sku)}\">`+this.render(item,options)\n+`</li>`;},rawSku:rawSku,};});","Reflet_UserRecommendation/js/product-list.min.js":"define(['jquery','Reflet_UserRecommendation/js/utils/storage','jquery-ui-modules/widget','mage/mage','owMod13','owModUtils',],function($,urStorage){\"use strict\";$.widget('reflet.userRecommendationProductList',{options:{enabled:0,minProducts:2,url:'',},_create:function(){if(!this.options.enabled){this._clearDom();return;}\nconst items=urStorage.getSectionData('productView',[]);if(items.length<this.options.minProducts){this._clearDom();return;}\nurStorage.fetchWithCache(this.options.url,'productViewCache',(response,fromCache)=>{if(response.success){if(fromCache){this.element.html(response.html);}else{this._fillHtml(response.data);}\nthis._initSlider();}else{this._clearDom();}},()=>this._clearDom());},_clearDom:function(){let tab=this.element.closest('[data-content-type=\"tab-item\"]');if(tab.length){let tabId=tab.attr('id');let tabLink=$(`a[href=\"#${tabId}\"]`);if(tabLink.length){tabLink.parent().remove();}\ntab.remove();}else{let mod=this.element.closest('[data-content-type=\"module_13\"]');if(mod.length){mod.remove();}else{this.element.remove();}}},_fillHtml:function(data){if(!data||!data.length||data.length<this.options.minProducts){this._clearDom();return;}\nlet html='';data.forEach(item=>{html+=`<li class=\"ow-slider__item swiper-slide\">${item.html}</li>`;});this.element.html(html);const cachedResponse=urStorage.getSectionData('productViewCache',null);if(cachedResponse&&cachedResponse.success){cachedResponse.html=html;urStorage.setSectionData('productViewCache',cachedResponse);}},_initSlider:function(){let mod13=this.element.closest('[data-content-type=\"module_13\"]');if(mod13){mod13.mage('owMod13',{flag:false,gridMode:false,mainProductSku:'',});mod13.initProductsTracking({selector:'.ow-prod__link-over, .ow-prod .action',productParentSelector:'.ow-prod'});}\nthis.element.addClass('_loaded');let _self=this;this.element.find('.ow-prod').each(function(){const productData=$(this).find('.tracking-data').data('product-dl');if(productData){$(this).find('a').on('click',function(e){_self._track(productData);});}});},_track:function(productData){if(window.dataLayer){window.dataLayer.push(productData);}}});return $.reflet.userRecommendationProductList;});","Reflet_UserRecommendation/js/utils/storage.min.js":"define(['jquery','underscore','jquery/jquery-storageapi',],function($,_){'use strict';const namespace='mage-customer-recommendation';const sections=['productView','productViewHash','productViewCache','pdpVariations','pdpVariationsHash'];const dynamicSections=new Set();let storage=null;function getStorage(){if(storage===null){storage=$.initNamespaceStorage(namespace).localStorage;}\nreturn storage;}\nfunction registerSection(section){if(!sections.includes(section)&&!dynamicSections.has(section)){dynamicSections.add(section);}}\nfunction isSectionAllowed(section){return sections.includes(section)||dynamicSections.has(section);}\nfunction getSectionData(section,defaultValue={}){if(!isSectionAllowed(section)){return defaultValue;}\ntry{const data=getStorage().get(section);return data??defaultValue;}catch(e){console.error(e);}\nreturn defaultValue;}\nfunction setSectionData(section,newData){if(!isSectionAllowed(section)){return;}\ntry{getStorage().set(section,newData);}catch(e){console.error(e);}}\nfunction clearSectionData(section){if(!isSectionAllowed(section)){return;}\ntry{getStorage().remove(section);}catch(e){console.error(e);}}\nfunction fetchWithCache(url,cacheKey,successCallback,errorCallback,cacheTTL=0){const rawItems=getSectionData('productView',[]);const items=rawItems.map(({data,...rest})=>rest);const hash=btoa(JSON.stringify({items,url}));const hashKey=cacheKey+'Hash';const ttlKey=cacheKey+'TTL';registerSection(cacheKey);registerSection(hashKey);if(cacheTTL>0){registerSection(ttlKey);}\nconst savedHash=getSectionData(hashKey,'');const cache=getSectionData(cacheKey,null);if(hash===savedHash&&cache){if(cacheTTL>0){const storedTs=getSectionData(ttlKey,0);if(storedTs&&Date.now()-storedTs<cacheTTL){successCallback(cache,true);return;}}else{successCallback(cache,true);return;}}\nconst controller=new AbortController();const timeoutId=setTimeout(()=>controller.abort(),15000);fetch(url,{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify(items),signal:controller.signal}).then(response=>{clearTimeout(timeoutId);return response.json();}).then((response)=>{setSectionData(hashKey,hash);setSectionData(cacheKey,response);if(cacheTTL>0){setSectionData(ttlKey,Date.now());}\nsuccessCallback(response,false);}).catch((error)=>{clearTimeout(timeoutId);if(errorCallback){errorCallback(error);}});}\nreturn{namespace:namespace,getSectionData:getSectionData,setSectionData:setSectionData,clearSectionData:clearSectionData,fetchWithCache:fetchWithCache,};});","Reflet_VideoAppointment/js/ajax-add-to-video-appointment.min.js":"define(['jquery','underscore',\"mage/translate\",'Magento_Customer/js/customer-data','Magento_Ui/js/modal/modal','jquery-ui-modules/widget'],function($,_,$t,customerData,modal){'use strict';$.widget('reflet.ajaxAddToVideoAppointment',{options:{type:'appointment-products',selector:'[data-action=\"add-to-video-appointment\"]'},wait:false,_create:function(){if($(this.element).data(