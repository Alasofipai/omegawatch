:'',productType:'',productData:{}},_create:function(){const sku=this.options.sku;const productType=this.options.productType;const productData=this.options.productData;if(!this.options.collectEnabled){urStorage.clearSectionData('productView');return;}\nif(!sku||this.options.maxViewed<=0){return;}\nthis._addItem(sku,productType,productData);document.addEventListener(\"visibilitychange\",()=>{if(!document.hidden){this._addItem(sku,productType,productData,false);}});},_addItem:function(sku,productType,productData,increment=true){const now=Math.floor(Date.now()/ 1000);const items=urStorage.getSectionData('productView',[]);const existing=items.find(item=>item.sku===sku);if(existing){existing.last_seen=now;existing.type=productType;existing.data=productData;existing.count+=(increment?1:0);}else{items.push({sku,last_seen:now,count:1,type:productType,data:productData});}\nitems.sort((a,b)=>b.last_seen-a.last_seen);urStorage.setSectionData('productView',items.slice(0,this.options.maxViewed));}});return $.reflet.userRecommendationPdpInit;});","Reflet_UserRecommendation/js/pdp-variations.min.js":"define(['jquery','underscore','Magento_Customer/js/customer-data','Reflet_UserRecommendation/js/utils/storage','Reflet_UserRecommendation/js/product-card-renderer','jquery-ui-modules/widget',],function($,_,customerData,urStorage,cardRenderer){\"use strict\";$.widget('reflet.userRecommendationPdpVariations',{options:{url:'',sourceLimit:3,minProducts:2,currentSku:'',storeCode:'',observerMargin:'200px',requestTimeout:15000,card:{listName:'dynamic_variations_pdp',},},_create:function(){if(!this.options.url||this.options.sourceLimit<1){return;}\nthis._observe();},_observe:function(){if(!('IntersectionObserver'in window)){this._load();return;}\nconst observer=new IntersectionObserver((entries)=>{if(entries.some(entry=>entry.isIntersecting)){observer.disconnect();this._load();}},{rootMargin:this.options.observerMargin});observer.observe(this.element[0]);},_load:function(){const sources=this._getTopSources();if(sources.length<this.options.sourceLimit){return;}\nconst hash=btoa(JSON.stringify({store:this.options.storeCode,sources:sources.slice().sort(),}));const cached=urStorage.getSectionData('pdpVariations',null);if(hash===urStorage.getSectionData('pdpVariationsHash','')&&this._isRenderable(cached)){this._render(cached);return;}\nthis._fetch(sources,hash);},_isRenderable:function(response){if(!response){return false;}\nif(!response.success){return true;}\nreturn Array.isArray(response.data)&&response.data.every(item=>item&&item.cta&&item.tracking);},_normalizeSku:function(sku){return String(sku).replace(/\\./g,'');},_getTopSources:function(){const scores={};urStorage.getSectionData('productView',[]).forEach((item)=>{if(!item.sku||(item.data&&item.data.is_watch===false)){return;}\nscores[this._normalizeSku(item.sku)]={sku:item.sku,score:item.count||0,lastSeen:item.last_seen||0,};});const cart=customerData.get('cart')();((cart&&cart.items)||[]).forEach((item)=>{if(!item.product_sku){return;}\nconst key=this._normalizeSku(item.product_sku);const entry=scores[key]||{sku:key,score:0,lastSeen:0};entry.score+=parseFloat(item.qty)||0;scores[key]=entry;});return Object.values(scores).sort((a,b)=>(b.score-a.score)||(b.lastSeen-a.lastSeen)).slice(0,this.options.sourceLimit).map(entry=>entry.sku);},_fetch:function(sources,hash){const controller=new AbortController();const timeoutId=setTimeout(()=>controller.abort(),this.options.requestTimeout);fetch(this.options.url,{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify({sources:sources,current_sku:this.options.currentSku}),signal:controller.signal}).then((response)=>{clearTimeout(timeoutId);return response.json();}).then((response)=>{urStorage.setSectionData('pdpVariationsHash',hash);urStorage.setSectionData('pdpVariations',response);this._render(response);}).catch(()=>clearTimeout(timeoutId));},_render:function(response){if(!response||!response.success||!Array.isArray(response.data)){return;}\nconst currentSku=this._normalizeSku(this.options.currentSku);const items=response.data.filter(item=>item&&item.sku&&item.url&&this._normalizeSku(item.sku)!==currentSku);if(items.length<this.options.minProducts){return;}\nconst $list=this.element.find('.ow-product-list');if(!$list.length){return;}\n$list.html(items.map(item=>cardRenderer.renderSlide(item,this.options.card)).join(''));$list.trigger('contentUpdated');this._syncSlider();this._initTracking();},_syncSlider:function(){const slider=this.element.data('mageOwMod13');if(!slider||!slider.sliderInit){return;}\nslider.$items=this.element.find('.ow-slider__item');slider.$items.find('.ow-prod__desc-top').matchHeight({property:'min-height'});slider.$items.on('swatch.initialized',_.debounce(()=>$.fn.matchHeight._update(),50));slider.mainProductIndex=-1;slider.currentItemIndex=0;slider.savedSlideSnapIndex=0;if(slider.swiper){if(slider.swiperInit){slider.swiper.update();slider.swiper.slideTo(0,0);}else{slider.swiper.params.initialSlide=0;}}\n$.fn.matchHeight._update();},_initTracking:function(){const _self=this;const dlItems=[];let website=null,currency=null;this.element.find('.ow-product-list .ow-prod').each(function(){const productDl=$(this).find('.tracking-data').first().data('product-dl');const item=productDl?.ecommerce?.items?.[0];if(!item){return;}\ndlItems.push(item);website=website||productDl.ecommerce.website;currency=currency||productDl.ecommerce.currency;$(this).find('a').on('click',()=>_self._push(productDl));});if(!dlItems.length){return;}\nconst viewDl={event:'view_item_list',ecommerce:{website:website,items:dlItems}};if(currency){viewDl.ecommerce.currency=currency;}\nthis._push(viewDl);},_push:function(data){if(window.dataLayer){window.dataLayer.push(data);}}});return $.reflet.userRecommendationPdpVariations;});","Reflet_UserRecommendation/js/product-card-renderer.min.js":"define([],function(){\"use strict\";const ENTITIES={'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'};const DEFAULTS={listName:'',productClasses:'ow-prod--m-v ow-prod--t-v ow-prod--l-v ow-prod--l-v--small ow-prod--watch',greyBg:true,imageSizes:'(max-width: 1024px) 210px, (max-width: 1299px) 420px, 460px',imageWidths:[210,420,460],lazyLoad:true,};const escapeHtml=value=>String(value??'').replace(/[&<>\"']/g,char=>ENTITIES[char]);const toText=html=>{const doc=new DOMParser().parseFromString(String(html??''),'text/html');return(doc.body.textContent||'').replace(/\\s+/g,' ').trim();};const rawSku=sku=>String(sku??'').replace(/\\./g,'');const renderTags=(tags,hiddenText)=>{if(!Array.isArray(tags)||!tags.length){return'';}\nreturn`<div class=\"ow-prod__tags\">${tags.join('')}<span class=\"hidden\"> - ${escapeHtml(hiddenText)}</span></div>`;};const renderImage=(item,alt,options)=>{const url=escapeHtml(item.image_url);const srcset=options.imageWidths.map(width=>`${url}?w=${width} ${width}w`).join(', ');const pattern=options.imageWidths.map(width=>`%img?w=${width} ${width}w`).join(', ');return`<div class=\"ow-el__picture ow-prod__picture\"><span>`+`<img alt=\"${escapeHtml(alt)}\" sizes=\"${escapeHtml(options.imageSizes)}\"`+` data-img=\"${url}\" data-srcset-pattern=\"${escapeHtml(pattern)}\" srcset=\"${srcset}\"`+` src=\"${url}?w=${options.imageWidths[0]}\"${options.lazyLoad ? ' loading=\"lazy\"' : ''} />`+`</span></div>`;};const renderPrice=price=>{if(!price){return'';}\nreturn`<p class=\"price-box price-final_price\">`+`<span class=\"price-container price-final_price tax weee\">`+`<span class=\"price-wrapper\"><span class=\"price\">${escapeHtml(price)}</span></span>`+`</span></p>`;};const renderActions=(item,sku,hiddenText)=>{const cta=item.cta||{};const label=cta.label||'';const mobileLabel=cta.label_mobile||label;const buttonId=`ow-button-ur-${sku}`;const status=label.trim().toLowerCase().replace(/\\s+/g,'-');return`<div class=\"ow-prod__actions\">`+`<a class=\"ow-link-underline\" href=\"${escapeHtml(item.url)}\"`+` aria-labelledby=\"product-label-