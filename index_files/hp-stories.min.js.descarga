(function(){"use strict";class OwHpStories{storageKey='mage-hp-stories';storageTimeout=3600000;constructor(element,attributes={}){this.element=element;this.options={baseUrl:'',locale:'',...attributes};this._loadStorageContent().then(html=>this._render(html));return this;};async _loadStorageContent(){const now=Date.now();let data=null;try{data=JSON.parse(localStorage.getItem(this.storageKey));}catch(error){data=null;}
const reload=!data||(now-data.time)>this.storageTimeout||data.locale!==this.options.locale;if(reload){return this._loadStories(now);}
return Promise.resolve(data.html);};async _loadStories(now){const url=this.options.baseUrl+'reflet/ajax/lang';const params={loadLanguageStories:1,loadLanguageMenu:0,};return this._fetchData(url,params).then(data=>{if(data.success){const html=data.html.homepageLatestStories??'';localStorage.setItem(this.storageKey,JSON.stringify({html:html,locale:this.options.locale,time:now,}));return Promise.resolve(html);}
return Promise.reject(Error('Stories data error!'));})};_render(html){this.element.innerHTML=html;const content=this.element.querySelector('#push-stories-hp-content');if(content){this.element.setAttribute('class',content.getAttribute('data-class'));this.element.setAttribute('data-tracking-title',content.getAttribute('data-tracking-title'));}
this.element.dispatchEvent(new CustomEvent('init_stories'));};async _fetchData(url,params={}){try{if(Object.keys(params).length){const queryString=new URLSearchParams(params).toString();url=`${url}?${queryString}`;}
const response=await fetch(url,{method:"GET"});if(!response.ok){return Promise.reject(Error(`HTTP error! Status: ${response.status}`));}
return await response.json();}catch(error){console.error(error);return Promise.reject(Error(`Fetch data error!`));}}}
window.OwHpStories=OwHpStories;})();