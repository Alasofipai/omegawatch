(function($){'use strict';$.fn.initOwModSPLazy=function(){return this.each(function(){if(this.querySelector('#push-stories-hp-content')){$(this).initOwModSP();}else{this.addEventListener('init_stories',()=>{$(this).initOwModSP();},{once:true});}});};$.fn.initOwModSP=function(){return this.each(function(){if($(this).data('init-sp')){return;}
$(this).data('init-sp',1);let element=$(this),elemToAnim=element.find('.ow-mod__wrapper'),stories=element.find('.ow-push-stories'),scroller=element.find('.ow-slider__items, .swiper'),scrollerDots=element.find('.ow-slider__dots'),scrollerList=element.find('.ow-push-stories__items'),scrollerElts=null,nbElts=0,retry=false,items=null,isSeen=false,isLoaded=false,isDisplayed=false;scroller.removeClass('ow-slider__items').addClass('swiper');scrollerList.addClass('swiper-wrapper swiper-wrapper--center');let options={isHomepage:(stories.attr('data-is-homepage')==='true'),isRelated:(stories.attr('data-is-related')==='true'),entityId:stories.attr('data-entity-id'),mainTag:stories.attr('data-main-tag'),hiddenTag:stories.attr('data-hidden-tag'),relatedTag:stories.attr('data-related-tag'),storiesLimit:stories.attr('data-limit'),ajaxStoriesUrl:stories.attr('data-url'),storeId:stories.attr('data-store-id'),isRandom:stories.attr('data-related-stories-mode')==='random'};if(options.isHomepage){scrollerElts=scroller.find('.ow-push-stories__item');nbElts=scrollerElts.length;_initSlider();}else{_ajaxLoadElements(options);}
elemToAnim.on("animSeen",onSeen);if(elemToAnim.data('seen')){onSeen();}
function onSeen(){isSeen=true;_animFade();}
function _animFade(){if(!isDisplayed&&isSeen&&isLoaded){element.initTracking({selector:'.ow-push-stories__item-link'});gsap.to(elemToAnim,{opacity:1,duration:.8,ease:Cubic.easeOut});isDisplayed=true;}}
function _initSlider(){if(!isLoaded){scrollerElts.addClass('swiper-slide');scrollerDots.show();new Swiper(scroller[0],{slidesPerView:1,resistance:false,setWrapperSize:true,roundLengths:true,breakpoints:{640:{slidesPerView:2,},960:{slidesPerView:3,},1300:{slidesPerView:4,}},pagination:{el:scrollerDots[0],enabled:true,clickable:true,bulletElement:'button',bulletClass:'ow-bullets__item',bulletActiveClass:'_active',},a11y:{enabled:true,containerRole:'list',slideRole:'listitem',slideLabelMessage:false,},});}
isLoaded=true;_animFade();}
function _ajaxLoadElements(params){let data={main_tag:params.mainTag};if(options.isRelated){data.story_id=params.entityId;data.related_stories_tag=params.relatedTag;data.store_id=params.storeId;}else{data.entity_id=params.entityId;data.hidden_tag=params.hiddenTag;}
const url=new URL(params.ajaxStoriesUrl,window.location.origin);Object.keys(data).forEach(key=>url.searchParams.append(key,data[key]));fetch(url,{method:'GET',headers:{'X-Requested-With':'XMLHttpRequest'}}).then(response=>response.json()).then(json=>{items=(params.isRelated)?json.relatedStories.items:json.pushStories.items;_showElements(items,params.storiesLimit,params.isRandom);}).catch(()=>{if(!retry){retry=true;_ajaxLoadElements(options);}});}
function _showElements(items,limit,random){let randomElements;if(random){randomElements=$($.trim(items)).filter('li').sort(function(){return Math.round(Math.random())-0.5}).slice(0,limit);}else{randomElements=$($.trim(items)).filter('li');randomElements=$(randomElements.get().reverse()).slice(0,limit);}
if(randomElements.length>0){$(randomElements.get()).each(function(current,elem){scrollerList.append(elem);});scrollerElts=scroller.find('.ow-push-stories__item');nbElts=scrollerElts.length;_initSlider();}else{console.log("empty selected stories");element.remove();}}});};})(jQuery);