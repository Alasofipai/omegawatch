define(['jquery','mage/translate','jquery/validate'],function($){'use strict';return function(){$.validator.addMethod("validate-intl-phone",function(value,element){const validator=this;const intlWidget=$(element).closest('[data-role="intl-widget"]');const dataValidateAttr=element.getAttribute('data-validate')||'';let isRequired;try{const dataValidate=JSON.parse(dataValidateAttr);isRequired=dataValidate.required===true;}catch(e){isRequired=false;}
if(!isRequired&&value===''){return true;}
if(intlWidget.length&&intlWidget.data('mageIntlTelInputWidget')){let isValid=intlWidget.intlTelInputWidget('isValid');if(!isValid){let phonePlaceholder=intlWidget.intlTelInputWidget('getPlaceholder');validator.errorMessage=$.mage.__("Please specify a valid phone for the selected country.").replace("%1",phonePlaceholder);return false;}}
return true;},function(){return this.errorMessage;});}});